{
  "name": "dsh-tui-filebrowser",
  "version": "0.1.0",
  "description": "Read-only snapshot file browser scene for dsh-TUI (tree + preview, no writes)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "ADMISSION.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify": "npm run build && npm run validate:manifest"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FUSU123fusu/dsh-tui-filebrowser.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.8.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
